# Build on a provisioning host with a preloaded base image and target-platform wheels.
# Use --network=none --pull=false; pass a reviewed digest through PYTHON_IMAGE.
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}
COPY wheelhouse/ /opt/wheelhouse/
RUN python -m pip install --no-index --find-links=/opt/wheelhouse pytest numpy sympy \
    && rm -rf /opt/wheelhouse
ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_INDEX=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HOME=/work
WORKDIR /work
USER 10001:10001
CMD ["python", "--version"]
